# Copy to .env.local and fill in. Never commit .env.local.
# Only the anon key belongs here — the service role key lives in Supabase
# Edge Function secrets and must never reach the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical origin used for SEO tags, sitemap.xml and robots.txt
VITE_SITE_URL=https://manpoweragency.eu
